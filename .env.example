# 集成测试环境配置示例
#
# 用法：复制本文件为仓库根目录下的 .env，并填入真实值。
#   cp .env.simple .env
#
# .env 已被 .gitignore 忽略，不会被提交；本文件（.env.simple）仅作模板，请勿填入真实密钥。
# 测试通过 internal/testenv 读取这些配置；对应变量未配置时，相关集成测试会自动跳过。

# ---- 缓存 Redis（cache 包集成测试）----
# 未配置 CACHE_REDIS_ADDR 时跳过 Redis 集成测试。
CACHE_REDIS_ADDR=127.0.0.1:6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=9
CACHE_PREFIX=infra-test:

# ---- 消息队列 Kafka（queue 包集成测试）----
# 未配置 QUEUE_BROKER 时跳过 Kafka 集成测试。
QUEUE_BROKER=127.0.0.1:9092

# ---- 对象存储 OSS（oss 包集成测试）----
# 未配置 OSS_ENDPOINT/OSS_BUCKET/OSS_ACCESS_ID/OSS_ACCESS_SECRET 时跳过阿里云 OSS 集成测试。
# 本地模式测试不依赖外部服务，无需配置。
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_ID=your-access-key-id
OSS_ACCESS_SECRET=your-access-key-secret
# 文件访问前缀 URL（如 CDN 域名或自定义域名）；不配置时回退为
# https://{Bucket}.{Endpoint}/{BaseDir}。
OSS_BASE_URL=
# 测试用 key 前缀，隔离测试文件与业务数据；未配置时默认 infra-test。
OSS_BASE_DIR=infra-test
